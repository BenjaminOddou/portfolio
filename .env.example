# Modèle des variables d'environnement.
# Copier ce fichier en « .env » (cp .env.example .env) puis renseigner les valeurs.
# Le fichier .env contient des secrets : il est ignoré par git, ne jamais le committer.
#
# En production (Netlify), définir les mêmes variables dans les réglages du site,
# ou leur équivalent lu à l'exécution : NUXT_IMAGEKIT_API, NUXT_PUBLIC_FORM_SPARK_ACTION_URL,
# NUXT_PUBLIC_BOTPOISON_PK.

# Clé API PRIVÉE ImageKit (utilisée uniquement côté serveur, par /api/images)
# ImageKit > Developer options > API keys > Private key
IMAGEKIT_API=

# URL d'envoi du formulaire de contact Formspark
# Formspark > formulaire > Action URL (ex. https://submit-form.com/xxxxxxxx)
FORMSPARK_ACTION_URL=

# Clé PUBLIQUE Botpoison, anti-robots du formulaire (commence par pk_)
# Botpoison > projet > Public key
BOTPOISON_PK=
